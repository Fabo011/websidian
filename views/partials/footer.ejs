<footer class="site-footer">
  <p class="footer-love">
    <span data-i18n="footer_love_pre">Developed with</span> <span class="footer-heart" aria-hidden="true">&#10084;</span> <span data-i18n="footer_love_post">by</span>
    <a href="https://github.com/Fabo011" target="_blank" rel="noopener noreferrer">Fabo011</a>
  </p>
  <nav class="footer-links">
    <a href="https://github.com/Fabo011/websidian" target="_blank" rel="noopener noreferrer" data-i18n="footer_source">Source code (Github)</a>
    <span class="footer-dot">&middot;</span>
    <a href="https://github.com/Fabo011/websidian/blob/main/docker-stack.yaml" target="_blank" rel="noopener noreferrer" data-i18n="footer_deploy">Deployment</a>
    <% if (typeof imprintEnabled !== 'undefined' && imprintEnabled) { %>
    <span class="footer-dot">&middot;</span>
    <a href="/imprint" data-i18n="footer_imprint">Imprint</a>
    <% } %>
    <% if (typeof privacyEnabled !== 'undefined' && privacyEnabled) { %>
    <span class="footer-dot">&middot;</span>
    <a href="/privacy" data-i18n="footer_privacy">Privacy</a>
    <% } %>
    <% if (typeof agbEnabled !== 'undefined' && agbEnabled) { %>
    <span class="footer-dot">&middot;</span>
    <a href="/agb" data-i18n="footer_agb">AGB</a>
    <% } %>
  </nav>
  <div class="footer-dev">
    <span class="footer-dev-title" data-i18n="footer_dev">For contributors</span>
    <% if (typeof codetriageBadge !== 'undefined' && codetriageBadge) { %>
    <a href="https://www.codetriage.com/fabo011/websidian" target="_blank" rel="noopener noreferrer" data-i18n-attr="title:footer_codetriage" title="Help triage issues on CodeTriage">
      <img src="<%= codetriageBadge %>" alt="CodeTriage contributors" />
    </a>
    <% } %>
    <% if (typeof deltachatChannel !== 'undefined' && deltachatChannel) { %>
    <a href="<%= deltachatChannel %>" target="_blank" rel="noopener noreferrer" data-i18n="footer_deltachat">DeltaChat channel</a>
    <% } %>
  </div>
  <p class="footer-disclaimer" data-i18n="footer_disclaimer">
    websidian is an independent, separate open-source project. It has no connection,
    affiliation, or partnership with Obsidian (obsidian.md). &ldquo;Obsidian&rdquo; is a
    trademark of its respective owner and is referenced here only for comparison.
  </p>
  <% if (typeof appVersion !== 'undefined' && appVersion) { %>
  <p class="footer-version">v<%= appVersion %></p>
  <% } %>
</footer>
